# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ollama_app?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here-change-this-in-production"

# API Authentication (for chat endpoint)
API_USERNAME="admin"
API_PASSWORD="password"
NEXT_PUBLIC_API_USERNAME="admin"
NEXT_PUBLIC_API_PASSWORD="password"

# Ollama Configuration
OLLAMA_HOST="http://localhost:11434"

# Rate Limiting & Caching Configuration
MAX_REQUESTS_PER_MINUTE="10"          # Anonymous users per minute
MAX_REQUESTS_PER_MINUTE_AUTH="20"     # Authenticated users per minute  
AUTH_MAX_REQUESTS_PER_HOUR="5"        # Auth attempts per hour
CACHE_TTL_MS="300000"                 # Cache TTL in milliseconds (5 min)
MAX_TOKENS="200"                      # Max tokens before cutoff

# Production Environment Variables (for Fly.io deployment)
# DATABASE_URL="postgresql://username:password@hostname:port/database"
# NEXTAUTH_URL="https://your-app.fly.dev"
# NEXTAUTH_SECRET="generate-a-secure-random-string-for-production"
# API_USERNAME="secure-username"
# API_PASSWORD="secure-password"
# NEXT_PUBLIC_API_USERNAME="secure-username"
# NEXT_PUBLIC_API_PASSWORD="secure-password"
# OLLAMA_HOST="http://your-ollama-service:11434"

# Production Rate Limiting (adjust based on your budget)
# MAX_REQUESTS_PER_MINUTE="50"
# MAX_REQUESTS_PER_MINUTE_AUTH="100"
# AUTH_MAX_REQUESTS_PER_HOUR="10"
# CACHE_TTL_MS="600000"
# MAX_TOKENS="500"
